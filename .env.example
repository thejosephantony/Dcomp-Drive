# Copie para .env e NÃO publique credenciais reais.
POSTGRES_PASSWORD=dev_only_change_me
NODE_TIMEOUT_SECONDS=6
REPLICATION_FACTOR=3
WRITE_TIMEOUT_SECONDS=300
MAX_DISK_USAGE_PERCENT=90
# Criptografia AES-256-GCM implementada; ativação opcional e explícita.
ENCRYPTION_ENABLED=false
# Apenas quando ENCRYPTION_ENABLED=true; chave persistente de 32 bytes em Base64.
# Nunca versionar uma chave real. Gere localmente e guarde o .env privado.
# PRESERVE a mesma chave para ler arquivos cifrados mesmo após reinicializações.
# Faça cópia segura fora do host EC2, sem enviá-la ao repositório.
ENCRYPTION_KEY_BASE64=

# Gateway de transferência (limite 32 MiB por arquivo):
MAX_TRANSFER_BYTES=33554432
# O cliente usa DCOMP_BACKEND=mock por padrão. Para servidor remoto: http
# DCOMP_CONTROLLER_URL=http://127.0.0.1:8000

# Recuperação automática de réplicas após falha de nós:
# 1 reparo por vez; 0 significa sem limite de banda adicional.
MAX_CONCURRENT_RECOVERIES=1
REPAIR_BANDWIDTH_BYTES_PER_SEC=0
REPAIR_INTERVAL_SECONDS=2
REPAIR_CLAIM_SECONDS=180
# Verificação periódica de integridade dos objetos (segundos):
SCRUB_INTERVAL_SECONDS=15
# Estrutura JSON com timestamp UTC, componente e evento:
LOG_FORMAT=json
